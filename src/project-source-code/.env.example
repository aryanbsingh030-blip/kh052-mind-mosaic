# =============================================================================
# AI Skill Exchange — Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your target deployment environment.

# -----------------------------------------------------------------------------
# 1. Environment & Server
# -----------------------------------------------------------------------------
APP_NAME="AI Skill Exchange"
APP_VERSION="0.1.0"
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET_KEY=skill-exchange-dev-secret-key-change-in-prod-99382104

# -----------------------------------------------------------------------------
# 2. Database (SQLite for local/offline, PostgreSQL for production)
# -----------------------------------------------------------------------------
# Local Development & Offline Demo (Zero-config SQLite):
DATABASE_URL=sqlite+aiosqlite:///./skill_exchange.db

# Online Production (PostgreSQL Container):
# DATABASE_URL=postgresql+asyncpg://skilluser:skillpass123@postgres:5432/skill_exchange

# PostgreSQL Container Credentials (used by docker-compose):
POSTGRES_USER=skilluser
POSTGRES_PASSWORD=skillpass123
POSTGRES_DB=skill_exchange
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 3. AI Provider Abstraction
# -----------------------------------------------------------------------------
# Options: mock | local | ollama | cloud
# - mock: Deterministic test heuristics (instant, zero cost)
# - local: Local heuristic semantic rules (offline demo)
# - ollama: Local LLM via Ollama server (privacy-first on-campus AI)
# - cloud: Cloud LLM API (OpenAI / Anthropic / Gemini compatible)
AI_PROVIDER=mock

# Ollama settings (when AI_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud LLM settings (when AI_PROVIDER=cloud):
LLM_API_KEY=
LLM_API_URL=https://api.example.com/v1

# -----------------------------------------------------------------------------
# 4. Credit Economy Configuration (Stage 7)
# -----------------------------------------------------------------------------
ALLOW_NEGATIVE_BALANCE=false
DEFAULT_SESSION_CREDIT_COST=10
MAX_DAILY_SESSIONS_PER_PAIR=3
HIGH_DEMAND_THRESHOLD=1.5

# -----------------------------------------------------------------------------
# 5. Frontend Configuration (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=production

